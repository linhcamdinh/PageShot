{
  "manifest_version": 3,
  "name": "Pageshot",
  "version": "1.0.1",
  "description": "Capture visible tabs, full scrolling pages, selected regions or your whole screen.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pageshot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "desktopCapture",
    "storage"
  ],
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture the visible part of the tab"
    },
    "capture-full": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture the full scrolling page"
    },
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Capture a selected region"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "vendor/ExtPay.js"
      ],
      "run_at": "document_start"
    }
  ]
}
